# CampusConnect v2 - TEMPLATE ONLY. Copy to .env (or run `python tools/campusctl.py env-init`).
# Every CHANGE_ME_* value must be replaced; services refuse to start with short secrets.
POSTGRES_DB=campusconnect
POSTGRES_USER=campusconnect
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_PORT=5432

BACKEND_PORT=8080
GATEWAY_PORT=3001
ML_SERVICE_PORT=5100
RECEIVER_HEALTH_PORT=4001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Critical Notice Delivery (TEST MODE) ---
RECEIVER_ID=RX-LIB
UDP_PORT=41234
TCP_EVENT_PORT=41235
CRITICAL_TEST_MODE=true
# >= 32 chars. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
PROTOCOL_KEY_ID=k1
PROTOCOL_HMAC_SECRET=CHANGE_ME_at_least_32_random_characters
ACK_MODE=LOCAL_DURABLE
INTERNAL_SERVICE_TOKEN=CHANGE_ME_internal_token_at_least_32_chars

ML_SERVICE_URL=http://localhost:5100
BACKEND_URL=http://localhost:8080
GATEWAY_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_PORT=5000
AI_REQUEST_TIMEOUT_MS=20000
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

INSTITUTIONAL_EMAIL_DOMAINS=vit.edu,vit.ac.in,example.edu
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
DATABASE_URL=jdbc:postgresql://localhost:5432/campusconnect
DATABASE_USERNAME=campusconnect
DATABASE_PASSWORD=CHANGE_ME_postgres_password

# Optional LLM features (M5). Leave empty to run fully offline with deterministic fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=

KNOWLEDGE_BASE_PATH=../knowledge-base
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
# Shared seed password for demo student accounts (seed_tickets.py, seed_academics.py).
# Change before any shared/public deployment.
STUDENT_SEED_PASSWORD=CHANGE_ME_strong_student_seed_password
FEATURE_ACADEMICS=false
